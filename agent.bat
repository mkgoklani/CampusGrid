@echo off
setlocal enabledelayedexpansion

title CampusGrid Agent Node (v1.0.6)
cd /d "%~dp0"

echo ================================================================
echo           CAMPUSGRID DISTRIBUTED COMPUTE AGENT NODE             
echo                   Version: v1.0.6 (Build 106)
echo ================================================================
echo.

:: 1. Check if Java 17+ is installed
where java >nul 2>nul
if %errorlevel% neq 0 (
    echo [WARNING] Java command not found in system PATH.
    echo Checking standard installation directories...
    set "FOUND_JAVA="
    for /d %%D in ("C:\Program Files\Eclipse Adoptium\jdk-*" "C:\Program Files\Eclipse Adoptium\jre-*" "C:\Program Files\Java\jdk-*" "C:\Program Files\Microsoft\jdk-*") do (
        if exist "%%D\bin\java.exe" set "FOUND_JAVA=%%D\bin\java.exe"
    )
    if defined FOUND_JAVA (
        echo [OK] Found Java at: !FOUND_JAVA!
        set "JAVA_CMD=!FOUND_JAVA!"
    ) else (
        echo.
        echo [ERROR] Java (Version 17+) is required to run CampusGrid Agent.
        echo.
        echo Would you like to automatically install Java 17 using Winget? (Y/N)
        set /p "INSTALL_CHOICE=Choice [Y/N]: "
        if /i "!INSTALL_CHOICE!"=="Y" (
            echo.
            echo [INSTALL] Installing Eclipse Adoptium OpenJDK 17...
            winget install EclipseAdoptium.Temurin.17.JRE
            echo.
            echo [NOTE] Java installed! Please re-run agent.bat.
            pause
            exit /b 0
        ) else (
            echo Please manually install Java 17 from: https://adoptium.net
            pause
            exit /b 1
        )
    )
) else (
    set "JAVA_CMD=java"
)

:: 2. Resolve Master Node Address
set "CONFIG_FILE=%~dp0master_node.txt"
set "DEFAULT_IP=100.66.175.104:8080"

if not "%~1"=="" (
    set "MASTER_ADDR=%~1"
) else (
    if exist "%CONFIG_FILE%" (
        set /p SAVED_IP=<"%CONFIG_FILE%"
        if not "!SAVED_IP!"=="" set "DEFAULT_IP=!SAVED_IP!"
    )
    echo ----------------------------------------------------------------
    echo Enter the Master Node IP:Port (Tailscale or Network IP)
    echo Default: [!DEFAULT_IP!]
    echo ----------------------------------------------------------------
    set /p "USER_INPUT=Master Address (Press Enter for default): "
    if "!USER_INPUT!"=="" (
        set "MASTER_ADDR=!DEFAULT_IP!"
    ) else (
        set "MASTER_ADDR=!USER_INPUT!"
    )
    echo !MASTER_ADDR!>"%CONFIG_FILE%"
)

echo !MASTER_ADDR! | findstr /c:":" >nul
if %errorlevel% neq 0 set "MASTER_ADDR=!MASTER_ADDR!:8080"

for /f "tokens=1,2 delims=:" %%A in ("!MASTER_ADDR!") do (
    set "MASTER_HOST=%%A"
    set "MASTER_PORT=%%B"
)

:: 3. Prepare standalone agent.jar runtime
set "TARGET_JAR=%~dp0agent.jar"

:: Extract embedded binary payload if local agent.jar is not found
if not exist "%TARGET_JAR%" (
    echo [EXTRACT] Extracting embedded CampusGrid Agent binaries...
    powershell -NoProfile -Command "$lines = Get-Content -LiteralPath '%~f0'; $start = $false; $b64 = ''; foreach($line in $lines){ if($line -match '^::==START_B64_PAYLOAD==$'){ $start = $true; continue }; if($start){ $b64 += $line } }; if($b64.Length -gt 0){ [IO.File]::WriteAllBytes('%TARGET_JAR%', [Convert]::FromBase64String($b64)); exit 0 } else { exit 1 }"
)

echo.
echo ================================================================
echo Starting CampusGrid Agent Node connecting to: !MASTER_ADDR!
echo ================================================================
echo.

"!JAVA_CMD!" -jar "%TARGET_JAR%" !MASTER_ADDR!

echo.
echo [AGENT] Process exited.
pause
exit /b 0

